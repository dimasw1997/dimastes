# Salin file ini menjadi .env lalu sesuaikan nilainya.
# Jangan commit file .env yang sudah berisi token/password.

# --- Kriteria lowongan ---
# 50 kata kunci pencarian dan pencocokan judul lintas situs.
KEYWORDS=Inventory,Warehouse,PPIC,Material,Production,Logistics,Supply,Stock,Purchasing,Procurement,Planning,Quality,Audit,Operations,Manufacturing,Distribution,Shipping,Receiving,Storekeeper,Expedition,Import,Export,Freight,Transportation,Delivery,Dispatch,Packaging,Control,Management,Inventory Control,Stock Control,Warehouse Control,Material Control,Quality Control,Quality Assurance,Document Control,Project Control,Cost Control,Demand Planning,Supply Planning,Order Management,Purchasing Management,Procurement Management,Logistics Management,Warehouse Management,Inventory Management,Operations Management,Production Management,Supply Management,Distribution Management
# Satu atau banyak lokasi, dipisah koma. Pencarian dijalankan per lokasi.
LOCATIONS=Bandung,Jakarta,Tangerang,Bekasi,Karawang,Bogor,Cikarang
# Tambahan opsional (bila ingin jangkauan lebih luas):
# LOCATIONS=Bandung,Jakarta,Tangerang,Jababeka,Cimahi,Purwakarta,Bogor,Bekasi,Karawang,Cikarang
# LOCATION hanya dipakai bila LOCATIONS kosong.
LOCATION=Bandung

# Ikut sertakan lowongan yang sepenuhnya remote.
ALLOW_REMOTE=false
# Gaji terendah yang layak dilamar di Glints (gaji kosong tetap dilamar).
# Tidak dipakai lagi: batas gaji semua situs memakai MIN_SALARY.
GLINTS_MIN_SALARY=4500000
# Perusahaan yang selalu ditolak, dipisah koma (berlaku JobStreet & Glints).
BLOCKED_COMPANIES=royal abadi,ifa
# Batas bawah gaji. Lowongan tanpa info gaji TETAP boleh dilamar.
# Isi 0 untuk mematikan batas ini.
MIN_SALARY=4500000
MAX_EXPERIENCE_YEARS=5
EXCLUDE_KEYWORDS=principal,director,head,senior,lead
# Kata peran lain yang menandakan lowongan bukan bidang Anda. Judul seperti
# "Warehouse Sales Executive" ditolak walau kata "warehouse" cocok.
# Kosongkan untuk mematikan. Hanya berlaku bila REQUIRE_KEYWORD_MATCH=true.
EXCLUDE_TITLE_WORDS=sales,marketing,driver,kurir,kasir,barista,waiter,waitress,satpam,security,cleaning service,collector,teller,agen asuransi,personal assistant
# Perusahaan yang tidak ingin dilamar (mis. mantan perusahaan), dipisah koma.
# Dicocokkan longgar: "royal abadi" menangkap "PT Royal Abadi Sejahtera".
BLACKLIST_COMPANIES=

# Hanya lamar lowongan yang judulnya cocok dengan minat (KEYWORDS).
# false = lamar apa pun yang muncul di hasil pencarian.
REQUIRE_KEYWORD_MATCH=true
# Kata kunci untuk mencocokkan JUDUL lowongan (boleh lebih banyak dari
# KEYWORDS, tidak menambah waktu pencarian). Kosong = ikut KEYWORDS.
# Daftar kata kunci judul dipilih pengguna; tidak membuktikan pengalaman.
TITLE_KEYWORDS=Inventory,Warehouse,PPIC,Material,Production,Logistics,Supply,Stock,Purchasing,Procurement,Planning,Quality,Audit,Operations,Manufacturing,Distribution,Shipping,Receiving,Storekeeper,Expedition,Import,Export,Freight,Transportation,Delivery,Dispatch,Packaging,Control,Management,Inventory Control,Stock Control,Warehouse Control,Material Control,Quality Control,Quality Assurance,Document Control,Project Control,Cost Control,Demand Planning,Supply Planning,Order Management,Purchasing Management,Procurement Management,Logistics Management,Warehouse Management,Inventory Management,Operations Management,Production Management,Supply Management,Distribution Management

# Tolak lowongan yang lokasinya jelas di luar LOCATION.
# false = tampilkan semua hasil pencarian JobStreet
# true = hanya melamar lowongan di kota dalam LOCATIONS (bawaan sekarang).
# false = lamar di kota mana pun yang muncul di hasil pencarian.
STRICT_LOCATION=true

# JobStreet & Glints: lamar hanya lowongan yang kartunya menampilkan logo
# perusahaan (gambar kecil di kanan atas kartu). Lowongan tanpa logo dilewati.
# false = semua lowongan boleh dilamar. Periksa dulu deteksinya dengan:
#   python cli.py cek-logo        (JobStreet)
#   python cli.py glints cari     (Glints)
# Wajib logo/gambar perusahaan: berlaku di JobStreet & Glints.
# Indeed dikecualikan karena kartunya tidak memuat logo.
REQUIRE_COMPANY_LOGO=true

# --- Urutan hasil pencarian ---
# ListedDate = dari yang paling baru diposting, KeywordRelevance = relevansi
SORT_MODE=ListedDate
# true  = RISET DULU: kumpulkan semua lowongan dari seluruh kategori &
#         lokasi, hapus duplikat, nilai, peringkat, lalu ambil kandidat
#         terbaik sebanyak sisa kuota situs itu (lamaran pertama menunggu
#         riset selesai).
# false = lamar sambil mencari: halaman 1 semua kata kunci & lokasi dulu
#         (lowongan paling baru), baru turun ke halaman 2 yang lebih lama.
# Saat MAX_APPLY_PER_DAY > 0, mode riset dipakai otomatis karena slot yang
# tersisa hanya bisa diisi kandidat terbaik bila seluruh kandidat dibandingkan.
COLLECT_BEFORE_APPLY=true

# --- Riset lowongan (riset TIDAK dibatasi 50) ---
# 50 kategori dipakai sebagai kueri riset teks untuk ketiga situs.
# Ini bukan kategori resmi platform. Kosong = pakai KEYWORDS.
RESEARCH_KEYWORDS=Inventory,Warehouse,PPIC,Material,Production,Logistics,Supply Chain,Stock,Purchasing,Procurement,Planning,Quality,Audit,Operations,Manufacturing,Distribution,Shipping,Receiving,Storekeeper,Expedition,Import,Export,Freight,Transportation,Delivery,Dispatch,Packaging,Manufacturing Control,Production Planning,Production Control,Inventory Control,Stock Control,Warehouse Control,Material Control,Quality Control,Quality Assurance,Document Control,Project Control,Cost Control,Demand Planning,Supply Planning,Order Management,Purchasing Management,Procurement Management,Logistics Management,Warehouse Management,Inventory Management,Operations Management,Production Management,Supply Management
# Detik menunggu kartu lowongan muncul sebelum halaman dianggap kosong.
# Makin kecil makin cepat, tetapi halaman yang sangat lambat bisa terlewat.
# 3-20; bawaan 12.
SEARCH_WAIT=12

# Halaman riset untuk SETIAP kombinasi kata kunci x lokasi: halaman 1-3,
# lalu berhenti dan lanjut ke kata kunci/lokasi berikutnya. Maksimal 3
# halaman per kombinasi (batas tetap, tidak bisa dinaikkan) — halaman 4 dan
# seterusnya tidak pernah dibuka. Nilai 0 atau lebih dari 3 tetap dipakai
# sebagai 3; boleh diturunkan (mis. 2).
RESEARCH_MAX_PAGES=3
# 0 = hasil riset tanpa batas jumlah (pengaman opsional).
# 50 hanya batas LAMARAN per siklus, bukan batas riset.
RESEARCH_MAX_JOBS=0
# Indeed: lama menunggu halaman verifikasi Cloudflare (detik), sambil DIAM
# tanpa perintah ke Chrome. Halaman perantara butuh 30-60 detik untuk lolos
# sendiri; memeriksanya tiap detik justru membatalkan pemeriksaannya.
INDEED_TUNGGU_DETIK=180
# Cache hasil riset: satu kombinasi situs + kata kunci + lokasi + halaman
# dipakai ulang selama N menit, supaya menjalankan sesi kedua untuk mengejar
# 50 lamaran tidak membaca situs dari nol. 0 = selalu ambil ulang dari situs.
# Paksa ambil ulang sekali jalan dengan: jalankan.bat run --auto --segar
CACHE_RISET_MENIT=60
# Keterampilan yang dicari di deskripsi kartu untuk menilai kesesuaian
# keterampilan (satu poin per keterampilan yang disebut).
SKILL_KEYWORDS=inventory,stock,stok,persediaan,gudang,warehouse,ppic,mrp,sap,erp,wms,excel,spreadsheet,forecasting,forecast,demand planning,production planning,material control,supply chain,logistik,logistics,procurement,purchasing,pengadaan,stock opname,cycle count,lean,5s,iso 9001,negosiasi,negotiation,analisis,analysis,distribusi,distribution
PREFER_NEWEST=true
# Urutan pemilihan saat COLLECT_BEFORE_APPLY=true:
#   relevance = kecocokan tertinggi dulu (bawaan)
#   newest    = posting terbaru dulu
RANK_BY=relevance
# 0 = semua umur lowongan. Nilai valid JobStreet: 1, 3, 7, 14, 31
# Batas INKLUSIF: MAX_AGE_DAYS=7 menerima lowongan berumur 7 hari.
MAX_AGE_DAYS=7
# Tanggal publikasi yang tidak terbaca ("DATE_UNKNOWN") BUKAN dianggap baru.
# false = lowongan tetap dicoba (banyak kartu tanpa tanggal);
# true  = lowongan seperti itu ditolak agar lowongan lama tidak lolos.
TOLAK_UMUR_TAK_DIKETAHUI=false

# --- Perilaku sesi ---
# Target sekaligus batas PER SITUS dalam SIKLUS 24 JAM BERGULIR
# (JobStreet 50, Glints 50, Indeed 50 — hitungan tiap situs terpisah).
# Siklus dimulai pada lamaran pertama, bukan tengah malam: mulai 20:30 berarti
# slot ke-51 baru boleh besok 20:30. 0 = tanpa batas untuk semua situs.
# Bila target belum tercapai, akhir sesi menampilkan sisa yang kurang.
MAX_APPLY_PER_DAY=50
DELAY_BETWEEN_APPLY=3
# Auto recovery: lowongan yang gagal karena sebab sementara (timeout,
# internet putus, Chrome lambat) dicoba ulang sebelum dicatat failed.
# Kesalahan permanen (mis. login habis) tidak pernah diulang.
MAKS_ULANG=2
JEDA_ULANG=3
# Dipakai mode "lamar sambil mencari" dan perintah cek-logo.
MAX_PAGES=3
HEADLESS_MODE=false

# --- Menempel ke Chrome Anda sendiri (opsional) ---
# Isi dengan port dari chrome-debug.bat (bawaan skrip itu 9222) bila situs
# menampilkan "Just a moment..." (verifikasi Cloudflare). Chrome yang Anda
# buka sendiri tidak dicurigai bot. 0 = bot membuka Chrome sendiri.
CHROME_DEBUG_PORT=0
# Path chrome.exe bila Chrome tidak terpasang di lokasi bawaan (opsional).
CHROME_BINARY=

# --- Sesi login ---
# Program TIDAK pernah meminta email/password JobStreet. Login dilakukan
# sendiri di Chrome dan disimpan pada profil di bawah ini.
# Profil Chrome tetap: login sekali, sesi tersimpan untuk sesi berikutnya.
USE_PROFILE=true
# LOGIN_WAIT=false -> jangan menunggu; langsung berhenti bila belum login
LOGIN_WAIT=true
# Lama menunggu login di Chrome (detik); tidak perlu tekan Enter
LOGIN_TIMEOUT=300
# CHROME_PROFILE_DIR=C:\Users\NamaAnda\.dimastes\chrome-profile

# --- Lamaran otomatis ---
# true = bot menekan Lamar/Lanjutkan/Kirim lamaran sendiri (default).
# Pakai `run --manual` bila ingin meninjau sendiri.
AUTO_APPLY=true
# Batas lamaran otomatis per sesi (pengaman tambahan selain MAX_APPLY_PER_DAY).
# 0 = tanpa batas per sesi. Jangan diisi lebih kecil dari MAX_APPLY_PER_DAY,
# supaya kuota harian (mis. 50) bisa terpakai penuh dalam satu sesi.
AUTO_APPLY_MAX_PER_SESSION=0

# --- Peluncur satu klik (Lamar Otomatis.bat) ---
# Situs yang dijalankan, urut JobStreet -> Glints -> Indeed.
# Contoh melewati Glints: jobstreet,indeed
SITES=jobstreet,glints,indeed
# Detik maksimal mengenali tiap langkah alur lamaran sebelum dilewati
AUTO_APPLY_STEP_TIMEOUT=3
# Detik maksimal di halaman "Review and submit" (menunggu tombol + konfirmasi)
AUTO_APPLY_SUBMIT_TIMEOUT=20
# Simpan HTML/screenshot ke folder debug/ bila alur tidak dikenali
AUTO_APPLY_DEBUG=true

# --- Pertanyaan pilihan dari perusahaan (dropdown) ---
# Jawab otomatis pertanyaan seperti pengalaman kerja, gaji, pendidikan.
# Pertanyaan yang polanya tidak dikenali tidak ditebak: lowongan dilewati.
AUTO_ANSWER_QUESTIONS=true
# Ingat setiap jawaban yang Anda isi sendiri di formulir (skill, pilihan ganda,
# dropdown, kolom teks). Lamaran berikutnya terisi otomatis dari ingatan itu;
# bot hanya berhenti untuk pertanyaan yang belum pernah dijawab.
# Kelola dengan: python cli.py jawaban
INGAT_JAWABAN=true
# Bila ada kuesioner yang tidak bisa dijawab otomatis, bot menunggu sekian
# detik agar Anda mengisinya sendiri di jendela Chrome. Setelah isian lengkap,
# bot melanjutkan dan mengirim lamarannya. 0 = langsung dilewati.
AUTO_ANSWER_WAIT=20
# Gaji yang diharapkan, dalam rupiah (boleh juga "5" atau "5jt"). Kosong =
# pertanyaan gaji tidak dijawab dan lowongan yang memintanya dilewati.
EXPECTED_SALARY=5000000
# Total pengalaman kerja untuk profil/skor; bukan jawaban otomatis formulir.
YEARS_EXPERIENCE=3
# Bidang pengalaman untuk profil; bukan bukti lama pengalaman per jabatan.
EXPERIENCE_ROLES=inventory,stock,stok,persediaan,gudang,warehouse,ppic,production,produksi,material,perencanaan,planner,purchasing,procurement,pembelian,supply chain,logistik,logistics,distribusi,distribution,administrasi,admin,ekspor,impor,import,export,data,furniture,furnitur,manufactur,project control,quality,audit
# Pengaturan lama: jawaban Ya tidak lagi ditebak otomatis.
AUTO_ANSWER_YES=true
# Jenjang pendidikan untuk pertanyaan kualifikasi: S1, D3, S2, SMA.
EDUCATION_LEVEL=S1

# --- Isian lamaran otomatis ---
# Teks cover letter/pesan. Kosongkan bila tidak ingin diisi otomatis.
COVER_LETTER=
# Path CV untuk unggah otomatis, mis. C:\Users\ASUS\Documents\cv.pdf
RESUME_PATH=
# Berkas CV untuk pembacaan profil & skor kecocokan (.pdf/.docx/.txt).
# Isi lewat: jalankan.bat cv --pasang "C:\Users\ASUS\Documents\cv.docx"
CV_PATH=
# Prioritas (hanya mengatur URUTAN lamaran, tidak menyaring).
# Kosong = ikut urutan LOCATIONS.
PRIORITAS_LOKASI=
# Contoh: inventory,ppic,warehouse,supply chain
PRIORITAS_KATEGORI=
# Skor minimum 0-100 agar lowongan masuk antrean apply (0 = tanpa batas).
MIN_SKOR_CV=0

# --- Notifikasi (opsional) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Database (opsional) ---
# Lokasi database SQLite: riwayat lowongan, lamaran, antrean, dan jawaban
# formulir. Kosong = jobstreet_auto.db di folder proyek. Path relatif otomatis
# dijadikan absolut terhadap folder proyek, jadi aman dijalankan dari folder
# mana pun. Contoh: DB_PATH=D:\dimastes\jobstreet_auto.db
# DB_PATH=jobstreet_auto.db
