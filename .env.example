# Salin file ini menjadi .env lalu sesuaikan nilainya.
# Jangan commit file .env yang sudah berisi token/password.

# --- Kriteria lowongan ---
KEYWORDS=inventory control,inventory controller,PPIC,production planner,material planner,material controller,stock controller,inventory analyst
LOCATION=Bandung
MIN_SALARY=0
MAX_EXPERIENCE_YEARS=5
EXCLUDE_KEYWORDS=principal,director,head,senior,lead

# Tolak lowongan yang lokasinya jelas di luar LOCATION.
# false = tampilkan semua hasil pencarian JobStreet
STRICT_LOCATION=false

# --- Perilaku sesi ---
MAX_APPLY_PER_DAY=100
DELAY_BETWEEN_APPLY=3
MAX_PAGES=3
HEADLESS_MODE=false

# --- Notifikasi (opsional) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Database (opsional) ---
# DB_PATH=jobstreet_auto.db
